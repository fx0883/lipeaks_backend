# =============================================================================
# LiPeaks Backend 生产环境配置模板
# =============================================================================
# 使用说明：
# 1. 复制本文件为 .env.prod：cp .env.prod.example .env.prod
# 2. 填写所有 <...> 占位符为实际值
# 3. 设置文件权限：chmod 600 .env.prod
# 4. 切勿将 .env.prod 提交到 Git（应已在 .gitignore 中忽略）
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库配置（cPanel MySQL）
# -----------------------------------------------------------------------------
DB_NAME=<your_cpanel_db_name>
DB_USER=<your_cpanel_db_user>
DB_PASSWORD=<your_strong_db_password>
DB_HOST=localhost
DB_PORT=3306

# -----------------------------------------------------------------------------
# Django 安全配置
# -----------------------------------------------------------------------------
# 必须修改为随机长字符串，至少 50 个字符
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<your_random_secret_key_here>

# 调试开关（生产环境必须关闭）
# 注意：项目从 INFO 变量读取 DEBUG，不是 DEBUG 变量
INFO=False

# 日志输出方式
# True：输出到控制台（适合 Docker / 开发）
# False：写入 logs/ 目录（适合 cPanel 生产环境）
LOG_TO_CONSOLE=False

# 允许访问的主机，多个用逗号分隔
ALLOWED_HOSTS=<api.yourdomain.com>,<yourdomain.com>,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Redis / Celery 配置
# -----------------------------------------------------------------------------
# cPanel 共享主机通常没有 Redis，必须关闭 Celery
# 关闭后所有任务同步执行
CELERY_ENABLED=false

# 如果使用了外部 Redis 服务（如 Upstash），取消注释并配置
# CELERY_BROKER_URL=rediss://default:<password>@<host>:<port>
# CELERY_RESULT_BACKEND=rediss://default:<password>@<host>:<port>
# REDIS_URL=rediss://default:<password>@<host>:<port>

# -----------------------------------------------------------------------------
# 邮件配置（用于密码重置、通知等）
# -----------------------------------------------------------------------------
EMAIL_USE_CONSOLE=false
EMAIL_HOST_USER=<your_email@example.com>
# 注意：这里是邮箱授权码/应用密码，不是登录密码
EMAIL_HOST_PASSWORD=<your_email_app_password>
DEFAULT_FROM_EMAIL=<your_email@example.com>

# -----------------------------------------------------------------------------
# 微信小程序配置（如使用）
# -----------------------------------------------------------------------------
WECHAT_APPID=<your_wechat_appid>
WECHAT_SECRET=<your_wechat_secret>

# -----------------------------------------------------------------------------
# 站点 URL 配置
# -----------------------------------------------------------------------------
SITE_URL=<https://api.yourdomain.com>
FRONTEND_URL=<https://admin.yourdomain.com>

# -----------------------------------------------------------------------------
# 可选：功能开关
# -----------------------------------------------------------------------------
# 是否强制成员/匿名用户在 CMS 路径携带 X-Tenant-ID（默认开启）
# FEATURE_ENFORCE_TENANT_HEADER_FOR_MEMBER=True

# 租户中间件调试日志（生产环境建议关闭）
# TENANT_MIDDLEWARE_DEBUG=False
