 API请求频率限制配置
# 控制激活API的总体请求频率，防止系统过载
ACTIVATION_API_RATE_LIMIT = 100/hour

# 可疑活动检测 - IP频率限制配置
# 控制同一IP地址的激活频率，防止恶意批量激活
SUSPICIOUS_IP_ACTIVATION_LIMIT = 15
SUSPICIOUS_IP_CHECK_HOURS = 1

# 可疑活动检测 - 许可证频率限制配置  
# 控制同一许可证的重复激活频率，防止许可证滥用
SUSPICIOUS_LICENSE_ACTIVATION_LIMIT = 13
SUSPICIOUS_LICENSE_CHECK_MINUTES = 60



