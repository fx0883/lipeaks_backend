msgstr "Paramètres requis manquants : tenant_id et application_id"

msgid "Invalid access. Please use the correct link."
msgstr "Accès invalide. Veuillez utiliser le lien correct."

msgid "Invalid tenant"
msgstr "Locataire invalide"

msgid "Tenant not found or inactive."
msgstr "Locataire introuvable ou inactif."

msgid "Invalid software"
msgstr "Logiciel invalide"

msgid "Application not found or inactive."
msgstr "Application introuvable ou inactive."

msgid "Thank you for your feedback! We will review it shortly."
msgstr "Merci pour votre commentaire ! Nous l'examinerons bientôt."

msgid "Failed to submit feedback. Please try again."
msgstr "Échec de l'envoi du commentaire. Veuillez réessayer."

